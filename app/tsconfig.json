{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@agent/schemas": ["./packages/schemas/src/index.ts"],
      "@agent/events": ["./packages/events/src/index.ts"],
      "@agent/agent-tools": ["./packages/agent-tools/src/index.ts"],
      "@agent/classroom-api": ["./packages/classroom-api/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "services/**/*.ts", "scripts/**/*.ts"]
}
