              "required": [
                "points",
                "color"
              ]
            },
            "maxItems": 300
          },
          "scene": {
            "type": "object",
            "description": "Embedded Excalidraw scene. Board requests are limited to 10 MB.",
            "required": [
              "elements",
              "files",
              "sourceItems"
            ],
            "properties": {
              "elements": {
                "type": "array",
                "maxItems": 2000,
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
