        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "scout": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Citation"
                }
              }
            },
            "required": [
              "text",
              "citations"
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Citation"
                    }
                  },
                  "assessment": {
                    "type": "string",
                    "enum": [
                      "correct",
                      "partial",
                      "incorrect",
                      "none"
                    ]
                  },
                  "prerequisite": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "text",
                  "citations",
                  "assessment",
                  "prerequisite"
                ]
              }
            ]
          },
          "plan": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Citation"
                      }
                    },
                    "minutes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "text",
                    "citations",
                    "minutes"
                  ]
                }
              }
            },
            "required": [
              "reason",
              "steps"
            ]
          }
        },
        "required": [
          "minutes",
          "scout",
          "review",
          "plan"
        ]
      }
