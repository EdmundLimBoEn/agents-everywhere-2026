        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "teach",
              "answer",
              "question",
              "simplify",
              "example",
              "why",
              "skip",
              "recap"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 4000
