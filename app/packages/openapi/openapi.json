{
  "openapi": "3.1.0",
  "info": {
    "title": "Afterclass Study API",
    "version": "1.0.0",
    "description": "Local Bun API. Except status, routes require a Google OAuth access token whose audience matches GOOGLE_CLIENT_ID. Data is scoped to the verified Google user. Errors use {error,code}. JSON request limit is 300,000 bytes. Authenticated traffic is limited to 120 requests per minute per user per process. Common statuses: 400 validation, 401 Google authorization, 403 origin/account/access, 404 missing resource, 409 concurrent/stale update, 413 body limit, 415 content type, 422 no sources/lesson limit, 429 rate limit, 502 provider failure, 503 missing configuration. CORS is an exact origin allowlist. Google material access is read-only."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Default local server"
    }
  ],
  "security": [
    {
      "googleBearer": []
    }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Read configuration availability",
        "operationId": "getApiStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "configured": {
                      "type": "object",
                      "properties": {
                        "google": {
                          "type": "boolean"
                        },
                        "teaching": {
                          "type": "boolean"
                        },
                        "voice": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "google",
                        "teaching",
                        "voice"
                      ]
                    },
                    "storage": {
                      "const": "local"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "configured",
                    "storage",
                    "version"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/courses": {
      "get": {
        "summary": "List accessible courses",
        "operationId": "getApiCourses",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "courses": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  },
                  "required": [
                    "courses"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/{courseId}/posts": {
      "get": {
        "summary": "Read course posts and topics",
        "operationId": "getApiCoursesCourseidPosts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "posts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Post"
                      }
                    },
                    "topics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Topic"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "posts",
                    "topics",
                    "warnings"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/courses/{courseId}/relevant": {
      "post": {
        "summary": "Find assignment-related materials",
        "operationId": "postApiCoursesCourseidRelevant",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "posts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Post"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "posts",
                    "warnings"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Ranks up to 10 other attached posts using matching topic and title/description terms.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "assignment": {
                    "$ref": "#/components/schemas/PostRef"
                  }
                },
                "required": [
                  "assignment"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/profile": {
      "get": {
        "summary": "Read learner profile",
        "operationId": "getApiProfile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update learner preferences",
        "operationId": "putApiProfile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Existing assessment evidence is retained; supplied evidence is ignored.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete all saved data for the authenticated learner",
        "operationId": "deleteApiProfile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Deletes profile, lessons, and cached turns. Does not delete Google resources. Returns 409 while a lesson is updating."
      }
    },
    "/api/profile/evidence/{evidenceId}": {
      "delete": {
        "summary": "Forget assessment evidence",
        "operationId": "deleteApiProfileEvidenceEvidenceid",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Removes evidence from profile and lessons and clears cached turn snapshots.",
        "parameters": [
          {
            "name": "evidenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          }
        ]
      }
    },
    "/api/lessons": {
      "get": {
        "summary": "List up to 100 recent saved lessons",
        "operationId": "getApiLessons",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lessons": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LessonSummary"
                      }
                    }
                  },
                  "required": [
                    "lessons"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      },
      "post": {
        "summary": "Create a lesson from accessible Classroom posts",
        "operationId": "postApiLessons",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lesson"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Loads current Google sources; per-attachment failures are returned. Up to 40 attachments, 15 MiB per file, 150 PDF pages, 250,000 characters per document and 600,000 characters per lesson.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLesson"
              }
            }
          }
        }
      }
    },
    "/api/lessons/{lessonId}": {
      "get": {
        "summary": "Resume lesson and refresh Google source access",
        "operationId": "getApiLessonsLessonid",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lesson"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete lesson and related evidence",
        "operationId": "deleteApiLessonsLessonid",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/lessons/{lessonId}/board": {
      "put": {
        "summary": "Save shared board",
        "operationId": "putApiLessonsLessonidBoard",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "board": {
                      "$ref": "#/components/schemas/Board"
                    }
                  },
                  "required": [
                    "board"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Board"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/lessons/{lessonId}/turn": {
      "post": {
        "summary": "Run an adaptive teaching turn",
        "operationId": "postApiLessonsLessonidTurn",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lesson"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Google access is rechecked, including retries. Requires configured teaching model and readable sources. Returns 409 for stale revision, concurrent update, or conflicting request ID. Maximum 400 messages per lesson.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Turn"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/lessons/{lessonId}/voice": {
      "post": {
        "summary": "Create an ephemeral Realtime credential",
        "operationId": "postApiLessonsLessonidVoice",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Requires configured Realtime model and readable sources. Client uses value for WebRTC. Student tool calls must be submitted to the authoritative turn endpoint; never persist this credential.",
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/lessons/{lessonId}/sources/{sourceId}/preview": {
      "get": {
        "summary": "Fetch authorized PDF preview as base64",
        "operationId": "getApiLessonsLessonidSourcesSourceidPreview",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentEncoding": "base64",
                      "contentMediaType": "application/pdf"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          },
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/lessons/{lessonId}/sources/{sourceId}/pdf": {
      "get": {
        "summary": "Fetch authorized inline PDF",
        "operationId": "getApiLessonsLessonidSourcesSourceidPdf",
        "responses": {
          "200": {
            "description": "PDF content",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Error; code identifies setup/auth/access/validation/conflict/provider failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          },
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 200
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "googleBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Google OAuth access token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "PostRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "courseWork",
              "courseWorkMaterials",
              "announcements"
            ]
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "name": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "alternateLink": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Topic": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "topicId",
          "name"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "courseWork",
              "courseWorkMaterials",
              "announcements"
            ]
          },
          "courseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "topicId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "alternateLink": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 200
                },
                "title": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ]
            }
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "courseId",
          "title",
          "description",
          "attachments"
        ]
      },
      "Passage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "heading": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "Source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
          "title": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "postIds": {
