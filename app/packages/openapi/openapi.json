                  "type": "object"
                }
              },
              "sourceItems": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/components/schemas/BoardItem"
                }
              }
            }
          }
        },
        "required": [
          "items",
          "strokes"
        ],
        "description": "At most 10,000 stroke points total; item IDs must be unique."
