            "type": "integer",
            "minimum": 0
          },
          "catchUpMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120,
            "description": "Opt into the four-agent catch-up crew with a time budget. Subsequent turns inherit the saved budget."
          }
        },
        "required": [
          "intent",
          "text",
          "requestId",
          "revision"
        ],
        "description": "answer/question require nonblank text. Reuse requestId only with an identical payload for idempotent retry. revision must match the current lesson."
      },
      "CreateLesson": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 200
          },
