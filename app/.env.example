# Copy to app/.env. Never commit credentials.
# Register this as a Chrome Extension OAuth client in your Google Cloud project.
# Stable unpacked extension ID: pdilhkaadeldjlpcnpebmhfchkoankec
GOOGLE_CLIENT_ID=
# Models selected for the local pilot; override explicitly when needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Local development. For a hosted server, use its HTTPS origin and rebuild.
API_ORIGIN=http://localhost:8787
PORT=8787
HOST=127.0.0.1
# Optional pilot account allowlist, comma-separated; blank permits authenticated app users.
ALLOWED_GOOGLE_USERS=
# Optional additional permitted web origins, comma-separated.
ALLOWED_ORIGINS=
# Optional overrides; defaults derive the extension ID and use app/data/study.sqlite.
# EXTENSION_ID=
# DATABASE_PATH=
